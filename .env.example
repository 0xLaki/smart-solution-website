# Smart Soultion site — copy to .env on the VM and fill in. Secrets live only in .env on the VM, never in git.
# Without the GigaChat and Telegram values everything still works: the assistant answers with the site's texts.

# Address the site links to itself with: canonical, og:url, og:image, sitemap.xml
SITE_URL=https://smart-soultion.com
# 1 = open to search engines (robots.txt with the sitemap, no noindex); 0 = closed test build
SITE_INDEX=1
# Port on 127.0.0.1 that Caddy proxies to
SITE_PORT=8090
# Image tag of the version to run (site and assistant); set to the git commit when building (see docs/DEPLOY.md)
SITE_TAG=latest

# --- Assistant «Смарт» (smart-api) ---
# GigaChat «Authorization Key» (developers.sber.ru → project GigaChat API → «Настройки API» → «Получить ключ»). SECRET
GIGACHAT_AUTH_KEY=
# GIGACHAT_API_PERS for an individual's key, GIGACHAT_API_B2B / GIGACHAT_API_CORP for a company's
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Model: GigaChat-2 (Lite), GigaChat-2-Pro, GigaChat-2-Max
GIGACHAT_MODEL=GigaChat-2-Pro
# Folder on the VM with the Russian Trusted Root CA in PEM (russian_trusted_root_ca_pem.crt); mounted into the container
GIGACHAT_CA_DIR=./deploy/certs
# Telegram bot from @BotFather: its token (SECRET) and its username, for the login button and the hand-off to Misha
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Chat the hand-off goes to: Misha's own Telegram id (after he presses Start in the bot) or a group id
TELEGRAM_NOTIFY_CHAT_ID=
# Visitor messages before Misha can be called in
SMART_HANDOFF_MIN=35

# --- Team admin panel (smart-soultion.com/admin/, served by smart-api) ---
# Key that signs the login cookie: `openssl rand -base64 32`. SECRET. Empty (or shorter than 32 characters) = admin off
SMART_ADMIN_SECRET=
# The site's own address: the wallet login message names it, and admin POSTs from any other Origin are refused
SMART_SITE_ORIGIN=https://smart-soultion.com
# Who may log in. Each way is on only when its list (and its setting) is filled; lists are comma-separated.
# Telegram user ids (numbers); the login uses the same bot as above (TELEGRAM_BOT_TOKEN / TELEGRAM_BOT_USERNAME)
SMART_ADMIN_TELEGRAM_IDS=
# Google OAuth «Web application» client id (…apps.googleusercontent.com); no client secret is needed
SMART_GOOGLE_CLIENT_ID=
# Google e-mails allowed in (any case)
SMART_ADMIN_EMAILS=
# Ethereum wallet addresses allowed in (0x…, any case)
SMART_ADMIN_WALLETS=
