# Smart Soultion site — copy to .env on the VM. There are no secrets: the site is static,
# the form and the assistant work in the browser and send nothing to a server.

# Address the site links to itself with: canonical, og:url, og:image, sitemap.xml
SITE_URL=https://smart-soultion.com
# 1 = open to search engines (robots.txt with the sitemap, no noindex); 0 = closed test build
SITE_INDEX=1
# Port on 127.0.0.1 that Caddy proxies to
SITE_PORT=8090
# Image tag of the version to run; set to the git commit when building (see docs/DEPLOY.md)
SITE_TAG=latest
